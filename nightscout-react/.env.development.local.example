# =============================================================================
# .env.development.local.example
# =============================================================================
# This is a template for your local development environment variables.
#
# SETUP INSTRUCTIONS:
# 1. Copy this file to .env.development.local:
#    cp .env.development.local.example .env.development.local
#
# 2. Edit .env.development.local with your real credentials
#
# 3. DO NOT commit .env.development.local (it's in .gitignore)
# =============================================================================

# Nightscout Backend URL
VITE_API_URL=https://your-nightscout-instance.herokuapp.com

# Subject Token (RECOMMENDED) - Get from Nightscout Admin Tools
VITE_SUBJECT_TOKEN=reactviewer-xxxxxxxxxxxxx

# OR: API Secret (LEGACY) - Only use for local development
# VITE_API_SECRET=your-api-secret-here

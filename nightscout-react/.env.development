# Nightscout Backend URL for development
# The Vite dev server will proxy all /api/* and /socket.io/* requests to this URL

# =============================================================================
# BACKEND URL
# =============================================================================

# Option 1: Your Nightscout instance on Heroku/Cloud
# VITE_API_URL=https://your-nightscout-instance.herokuapp.com

# Option 2: Local backend
VITE_API_URL=http://localhost:1337

# Note: No need to add /api/v1 - that's handled automatically

# =============================================================================
# AUTHENTICATION - Choose ONE of the following methods:
# =============================================================================

# ✅ RECOMMENDED: Subject Token from Admin Tools
# -----------------------------------------------------------------------------
# - Granular permissions (e.g., read-only)
# - Can be revoked individually
# - One token per app/client
# - Safer for production
# - Passed as URL parameter: ?token=xxx (like in old Nightscout project)
#
# How to create:
# 1. Go to Nightscout → Menu (☰) → Administrator-Werkzeuge
# 2. Enter your API_SECRET to access admin tools
# 3. Go to "Zugriffsschlüssel" (Access Keys/Subjects) tab
# 4. Create new subject:
#    - Subject Name: reactviewer
#    - Roles: ☑ readable (for read-only access)
# 5. Copy the generated token (format: "name-hash")
#
# Set this in .env.development.local (not here!):
# VITE_SUBJECT_TOKEN=reactviewer-xxxxxxxxxxxxx

# ⚠️  LEGACY: Master API_SECRET (Full Access - Not Recommended)
# -----------------------------------------------------------------------------
# - This is the master secret from your Nightscout server
# - Full administrative access to everything
# - Cannot be revoked without server restart
# - Use only for development/testing
#
# Set this in .env.development.local (not here!):
# VITE_API_SECRET=your-api-secret-here
#
# ⚠️  WARNING: Using API_SECRET gives FULL ACCESS to your Nightscout instance!
# For production, use VITE_SUBJECT_TOKEN instead.
# =============================================================================

# Priority: VITE_SUBJECT_TOKEN takes precedence over VITE_API_SECRET

# =============================================================================
# IMPORTANT: Keep your credentials safe!
# =============================================================================
# Do NOT put real credentials here - use .env.development.local instead!
#
# Copy .env.development.local.example to .env.development.local:
#   cp .env.development.local.example .env.development.local
#
# Then edit .env.development.local with your real values.
# This file is in .gitignore and won't be committed.
# =============================================================================
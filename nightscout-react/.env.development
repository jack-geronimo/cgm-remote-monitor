# Nightscout Backend URL for development
# The Vite dev server will proxy all /api/* and /socket.io/* requests to this URL

# Option 1: Local backend (default)
VITE_API_URL=http://localhost:1337

# Option 2: Your existing Nightscout instance in the cloud
# VITE_API_URL=https://your-nightscout.herokuapp.com

# Option 3: Public demo instance (if available)
# VITE_API_URL=https://demo.nightscout.io

# Note: No need to add /api/v1 - that's handled automatically
